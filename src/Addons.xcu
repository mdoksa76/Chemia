<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
 <node oor:name="AddonUI">
  <node oor:name="AddonMenu">
   <node oor:name="hr.mdoksa.chemia.menu" oor:op="replace">
    <prop oor:name="Title" oor:type="xs:string">
     <value xml:lang="hr">Kemija</value>
     <value xml:lang="en-US">Chemistry</value>
    </prop>
    <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
    <node oor:name="Submenu">

     <node oor:name="c01" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>service:hr.mdoksa.chemia.Handler?pse_dialog</value></prop>
      <prop oor:name="Title" oor:type="xs:string"><value xml:lang="hr">Periodni sustav / element…</value><value xml:lang="en-US">Periodic table / element…</value></prop>
      <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
     </node>
     <node oor:name="c02" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>service:hr.mdoksa.chemia.Handler?pse_table</value></prop>
      <prop oor:name="Title" oor:type="xs:string"><value xml:lang="hr">Periodni sustav (cijeli, brzo)</value><value xml:lang="en-US">Periodic table (full, quick)</value></prop>
      <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
     </node>

     <node oor:name="sep1" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
     </node>

     <node oor:name="c03" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>service:hr.mdoksa.chemia.Handler?molecule</value></prop>
      <prop oor:name="Title" oor:type="xs:string"><value xml:lang="hr">Molekula (PubChem)…</value><value xml:lang="en-US">Molecule (PubChem)…</value></prop>
      <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
     </node>

     <node oor:name="sep2" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
     </node>

     <node oor:name="c04" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>service:hr.mdoksa.chemia.Handler?edit</value></prop>
      <prop oor:name="Title" oor:type="xs:string"><value xml:lang="hr">Uredi označeni prikaz…</value><value xml:lang="en-US">Edit selected…</value></prop>
      <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
     </node>

    </node>
   </node>
  </node>
 </node>
</oor:component-data>
